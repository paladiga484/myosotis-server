/* The app's icon, version and manifest. version.h and app.ico are written by the package
 * build (build-windows-package.sh): VERSION_NUM like 1,117,1,0 and VERSION_STR "1.117.1". */
#include <windows.h>
#include "version.h"

1 ICON "app.ico"
1 RT_MANIFEST "app.manifest"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION VERSION_NUM
 PRODUCTVERSION VERSION_NUM
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "FileDescription", "Limbus Private Server"
      VALUE "ProductName", "Limbus Private Server"
      VALUE "FileVersion", VERSION_STR
      VALUE "ProductVersion", VERSION_STR
      VALUE "OriginalFilename", "Limbus Private Server.exe"
      VALUE "InternalName", "launcher"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
